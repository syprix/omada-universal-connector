# Example only — no real controller values or secret contents belong in this file.
# GET /omada/controller-info performs an unauthenticated read of GET /api/info.
OMADA_BASE_URL=https://controller.example.invalid
# For local self-signed controller certificates use pin_sha256. With a
# publicly trusted cloud certificate, system_ca checks the CA and hostname.
# The legacy /omada/controller-info route still requires a certificate pin.
OMADA_TLS_TRUST=pin_sha256
OMADA_CERT_SHA256=<64-hex-certificate-sha256>
OMADA_TIMEOUT_SECONDS=5
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# The Open API inventory routes require these runtime-only values. Mount files
# read-only at deployment; do not put their contents in environment variables.
# OMADA_CONTROLLER_ID=<id-from-controller-open-api-app>
# OMADA_CLIENT_ID_FILE=/run/secrets/omada_client_id
# OMADA_CLIENT_SECRET_FILE=/run/secrets/omada_client_secret
# OMADA_OPENAPI_PAGE_SIZE=100
# OMADA_OPENAPI_MAX_PAGES=10
# The caller token must be at least 32 bytes. Routes stay disabled without it.
# OMADA_CONNECTOR_TOKEN_FILE=/run/secrets/omada_connector_token
# Optional: pre-provisioned protected regular 32-byte binary key, readable by
# the container's user and mode 0400 or 0600. Never place its contents here.
# With no path, references change on restart and journal-backed writes stay off.
# OMADA_REFERENCE_KEY_FILE=/run/secrets/omada_reference_key
# Optional approval gate key, separate from caller and reference keys. Use an
# existing private 32-byte file, mode 0400 or 0600, readable by UID 10001.
# Never put key contents here; HMAC/operator IDs do not prove a human identity.
# OMADA_OPERATOR_APPROVAL_KEY_FILE=/run/secrets/omada_operator_approval_key
# Optional durable change-plan journal. Mount a private writable named volume
# at this existing image directory. The key above must be persistent too.
# Both keys and OMADA_ENABLE_WRITES=true are required for apply, along with a
# per-preview approval envelope from tools/approve_plan.py.
# OMADA_CHANGE_JOURNAL_DIR=/state/change-journal
# Optional, default false: reveal descriptive site/device/SSID names only in
# authenticated inventory results. Names themselves may contain private data.
# OMADA_EXPOSE_DESCRIPTIVE_NAMES=true

# Deliberate operator opt-in only after reviewing a concrete preview.
OMADA_ENABLE_WRITES=false
